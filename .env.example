# The API binds to localhost by default. Put it behind an authenticated TLS
# reverse proxy before exposing it beyond the machine.
API_PORT=8000

LLM_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text
EMBED_VECTOR_SIZE=768
SCORE_THRESHOLD=0.45

# Set a long random value to require X-API-Key on data/query endpoints.
# Example generator: openssl rand -hex 32
RAG_API_KEY=
