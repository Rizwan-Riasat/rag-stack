# Copy to .env to override the defaults.
#   cp .env.example .env
#
# LLM_MODEL options (all CPU-friendly, bigger = smarter but slower):
#   llama3.2:3b   (default) — good answers, ~2GB RAM. Recommended.
#   llama3.2:1b   — faster, but too weak to follow instructions reliably.
#   qwen2.5:0.5b  — tiniest, only for very constrained boxes.
LLM_MODEL=llama3.2:3b
EMBED_MODEL=nomic-embed-text
